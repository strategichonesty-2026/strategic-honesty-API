DATABASE_URL="file:./dev.db"
PORT=3000

# Google Cloud OAuth 2.0 client credentials (console.cloud.google.com)
# with the YouTube Data API v3 enabled and the youtube.upload scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/youtube/oauth2callback

# Shared secret required (via X-Internal-Token header) on service-to-service
# routes (/youtube/upload, /youtube/accounts, /youtube/upload-from-url).
# Must match the calling service's own copy of this same value.
INTERNAL_SERVICE_TOKEN=

# Where /youtube/oauth2callback redirects the browser after connecting —
# the calling application's backend, not a client-supplied value.
SCHEDULER_CALLBACK_URL=http://localhost:3001/auth/youtube/service-callback
